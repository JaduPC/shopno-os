#!/usr/bin/env bash
# =============================================================================
# Install xfce4-shopno-quicksettings-plugin for xfce flavor via deb package
# Not in an APT repo yet, so the release .deb is pinned by checksum. Moving it
# to the ShopnoOS APT repo is the long-term fix (as with #9).
# =============================================================================
set -euo pipefail

PACKAGE_NAME="xfce4-shopno-quicksettings-plugin"
PACKAGE_VERSION="0.2.0"
PACKAGE_ARCH="amd64"
PACKAGE_DIST="debian13"
# From the release's SHA256SUMS. Update together with PACKAGE_VERSION.
PACKAGE_SHA256="aff47aa717f4512a3a7035fcd4961581ab2604da370ecc6eb214da4900eda4b0"
DOWNLOAD_URL="https://github.com/fa-saikat/xfce4-shopno-quicksettings-plugin/releases/download/v${PACKAGE_VERSION}/${PACKAGE_NAME}_${PACKAGE_VERSION}-1.${PACKAGE_DIST}_${PACKAGE_ARCH}.deb"

PLUGIN_LIB="/usr/lib/x86_64-linux-gnu/xfce4/panel/plugins/libshopno-quicksettings.so"
PLUGIN_DESKTOP="/usr/share/xfce4/panel/plugins/shopno-quicksettings.desktop"

DEB_FILE="/tmp/${PACKAGE_NAME}_${PACKAGE_VERSION}.deb"

if dpkg-query -W -f='${Status}' "${PACKAGE_NAME}" 2>/dev/null | grep -q "install ok installed"; then
    echo "[ShopnoOS] ${PACKAGE_NAME} already installed, skipping."
    exit 0
fi

echo "[ShopnoOS] Installing ${PACKAGE_NAME} ${PACKAGE_VERSION} from upstream..."

wget --quiet --show-progress \
     --timeout=60 \
     --tries=3 \
     -O "${DEB_FILE}" \
     "${DOWNLOAD_URL}"

echo "${PACKAGE_SHA256}  ${DEB_FILE}" | sha256sum -c --quiet - \
    || { echo "[ShopnoOS] ERROR: ${PACKAGE_NAME} checksum mismatch." >&2; exit 1; }

dpkg -i "${DEB_FILE}" || apt-get install -f -y

rm -f "${DEB_FILE}"

# apt-get install -f can resolve a failed dpkg -i by removing the package, so
# check the package state and its files, not just the exit code.
dpkg-query -W -f='${Status}' "${PACKAGE_NAME}" 2>/dev/null | grep -q "install ok installed" \
    || { echo "[ShopnoOS] ERROR: ${PACKAGE_NAME} is not installed." >&2; exit 1; }

for f in "${PLUGIN_LIB}" "${PLUGIN_DESKTOP}"; do
    [[ -f "${f}" ]] || { echo "[ShopnoOS] ERROR: ${PACKAGE_NAME} is missing ${f}." >&2; exit 1; }
done

if ldd "${PLUGIN_LIB}" 2>/dev/null | grep -q "not found"; then
    echo "[ShopnoOS] ERROR: ${PACKAGE_NAME} has unresolved libraries:" >&2
    ldd "${PLUGIN_LIB}" 2>/dev/null | grep "not found" >&2
    exit 1
fi

echo "[ShopnoOS] ${PACKAGE_NAME} installed successfully."
